{
  "name": "upage",
  "version": "1.0.0",
  "license": "0BSD",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.2.0",
    "@iconify-json/lucide": "^1.2.133",
    "@iconify-json/simple-icons": "^1.2.96",
    "@iconify/vue": "^5.0.2",
    "entities": "^8.1.0",
    "fast-xml-parser": "^5.11.1",
    "ipaddr.js": "^2.5.0",
    "markdown-it": "^15.0.2",
    "sirv": "^3.0.2",
    "tsx": "^4.23.13",
    "vue": "^3.5.43",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.4",
    "typescript": "~5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18",
    "vue-tsc": "3.3.11"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "npm run typecheck && vite build && tsx scripts/build-static.ts",
    "typecheck": "vue-tsc --noEmit",
    "schema": "tsx scripts/config-schema.ts",
    "preview": "vite preview --host 127.0.0.1",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:static": "npm run build",
    "editor": "vite --mode edit --host 127.0.0.1 --port 4173 --open /__edit/",
    "test:editor": "playwright test --config playwright.editor.config.ts"
  }
}
